# Agg.market app id (x-app-id). Get it at https://admin.agg.market -> Develop -> API
AGG_APP_ID=
# x402 receiver: your Base USDC address. Leave empty to run in unpaid dev mode.
FINE_PRINT_PAY_TO=
FINE_PRINT_PRICE=$0.05
FINE_PRINT_NETWORK=eip155:8453
# Coinbase CDP facilitator credentials (needed for Base mainnet verify/settle)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Optional: a different x402 facilitator URL instead of CDP
X402_FACILITATOR_URL=
